# Αρχικός διαχειριστής Keycloak
KEYCLOAK_ADMIN_PASSWORD=

# Client σύνδεσης προσωπικού
OIDC_CLIENT_ID=medical-appointments-backend
OIDC_CLIENT_SECRET=

# Service account ελέγχου πρόσβασης
KEYCLOAK_ACCESS_CLIENT_ID=medical-access-checker
KEYCLOAK_ACCESS_CLIENT_SECRET=

# Κοινό μυστικό Vite server και backend
API_PROXY_SECRET=

# Κωδικός του περιορισμένου χρήστη PostgreSQL appointments_app
APP_DATABASE_PASSWORD=

# Διαχειριστική σύνδεση για migrations
MIGRATION_DATABASE_URL=postgresql://appointments@db:5432/appointments
MIGRATION_DATABASE_PASSWORD=